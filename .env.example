# ── CRM API ───────────────────────────────────────────────────────────
# Base URL for the Kalakaar Studios CRM backend. The blog system talks
# to this API exclusively (see src/lib/blog.ts).
NEXT_PUBLIC_CRM_API_URL=https://crm.kalakaarstudios.co.in/api

# ── Blog admin ────────────────────────────────────────────────────────
# Shared secret the moderation panel sends so the CRM can verify the
# editor before approving/rejecting posts.
NEXT_PUBLIC_ADMIN_KEY=kalakaar_super_secret_key_2026_xyz

# ── Cloudflare Pages deploy hook ──────────────────────────────────────
# Deploy hook URL (Cloudflare Pages -> Settings -> Builds & deployments).
# When set, saving an edited post (or approving one) fires the hook so the
# live site is rebuilt automatically.
NEXT_PUBLIC_CLOUDFLARE_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/3baf262e-475c-4c5b-98d4-1155ff5bae59

# ── Formspree (existing contact form) ─────────────────────────────────
NEXT_PUBLIC_FORMSPREE_ID=xvkojnov

# ── Artist registration & notifications (Cloudflare Pages Functions) ──
# These are NOT read by Next.js — they belong to the Pages Functions under
# `functions/`. Set them in Cloudflare Dashboard -> Pages project ->
# Settings -> Environment variables (production + preview), or pass them to
# `wrangler pages dev`. Values here document the contract only.

# KV namespace binding (variable name must be exactly KS_KV). Bind a namespace
# in Settings -> Functions so registrations, dedupe indexes and notifications
# persist; without it the API falls back to an ephemeral in-memory store.
#KS_KV=<binding: KV namespace>

# Resend API key — sends the "Welcome to Kalakaar Studios Artist Network —
# Bihar Got Talent Auditions" confirmation plus the studio alert.
#RESEND_API_KEY=re_...
# Verified sender for the above mails, e.g. "Kalakaar Studios <hello@kalakaarstudios.co.in>"
#RESEND_FROM=
# Studio inbox that receives a copy of every registration.
#ARTIST_INBOX=Kalakaarstudios@ssociopro.com

# Optional: POST endpoint that mirrors each artist row into the CRM.
#ARTIST_CRM_URL=https://crm.kalakaarstudios.co.in/api/artists
#CRM_ADMIN_KEY=

# Secret required by the /api/notifications "broadcast" action. If unset the
# broadcast action is disabled entirely.
#NOTIFY_ADMIN_KEY=<long random string>
