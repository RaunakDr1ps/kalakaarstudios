# ── CRM API ───────────────────────────────────────────────────────────
# Base URL for the Kalakaar Studios CRM backend. The blog system talks
# to this API exclusively (see src/lib/blog.ts).
NEXT_PUBLIC_CRM_API_URL=https://crm.kalakaarstudios.co.in/api

# ── Blog admin ────────────────────────────────────────────────────────
# Shared secret the moderation panel sends so the CRM can verify the
# editor before approving/rejecting posts.
NEXT_PUBLIC_ADMIN_KEY=kalakaar_super_secret_key_2026_xyz

# ── Cloudflare Pages deploy hook ──────────────────────────────────────
# Deploy hook URL (Cloudflare Pages -> Settings -> Builds & deployments).
# When set, saving an edited post (or approving one) fires the hook so the
# live site is rebuilt automatically.
NEXT_PUBLIC_CLOUDFLARE_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/3baf262e-475c-4c5b-98d4-1155ff5bae59

# ── Formspree (existing contact form) ─────────────────────────────────
NEXT_PUBLIC_FORMSPREE_ID=xvkojnov