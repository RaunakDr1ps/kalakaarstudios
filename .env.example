# ── CRM API ───────────────────────────────────────────────────────────
# Base URL for the Kalakaar Studios CRM backend. The blog system talks
# to this API exclusively (see src/lib/blog.ts).
NEXT_PUBLIC_CRM_API_URL=https://crm.kalakaarstudios.co.in/api

# ── Blog admin ────────────────────────────────────────────────────────
# Shared secret the moderation panel sends so the CRM can verify the
# editor before approving/rejecting posts.
NEXT_PUBLIC_ADMIN_KEY=change-me-to-a-long-random-string

# ── Formspree (existing contact form) ─────────────────────────────────
NEXT_PUBLIC_FORMSPREE_ID=xvkojnov